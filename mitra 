    // Virtual IndexedDB Storage Setup for Unlimited Capacity
    let db;
    const request = indexedDB.open("MitraUnlimitedDB", 1);
    request.onerror = function() { console.log("IndexedDB error"); };
    request.onsuccess = function(event) {
        db = event.target.result;
        loadAppData();
    };
    request.onupgradeneeded = function(event) {
        let database = event.target.result;
        if(!database.objectStoreNames.contains("appStore")) {
            database.createObjectStore("appStore", { keyPath: "id" });
        }
    };

    function saveAppData() {
        if(!db) return;
        try {
            let transaction = db.transaction(["appStore"], "readwrite");
            let store = transaction.objectStore("appStore");
            store.put({ id: "mainData", posts: globalPosts, stories: globalStories, chats: chatConversations, news: globalNews, books: globalBooks, profile: userProfileData, channel: userChannelData, author: userAuthorData });
        } catch(e) {
            console.log("Storage saved via memory fallback");
        }
    }

    function loadAppData() {
        if(!db) return;
        let transaction = db.transaction(["appStore"], "readonly");
        let store = transaction.objectStore("appStore");
        let req = store.get("mainData");
        req.onsuccess = function() {
            if(req.result) {
                if(req.result.posts) globalPosts = req.result.posts;
                if(req.result.stories) globalStories = req.result.stories;
                if(req.result.chats) chatConversations = req.result.chats;
                if(req.result.news) globalNews = req.result.news;
                if(req.result.books) globalBooks = req.result.books;
                if(req.result.profile) {
                    userProfileData = Object.assign(userProfileData, req.result.profile);
                    if(!userProfileData.firstName && userProfileData.name) {
                        let parts = userProfileData.name.split(" ");
                        userProfileData.firstName = parts[0] || "Mitra";
                        userProfileData.surname = parts.slice(1).join(" ") || "User";
                    }
                }
                if(req.result.channel) {
                    userChannelData = Object.assign(userChannelData, req.result.channel);
                }
                if(req.result.author) {
                    userAuthorData = Object.assign(userAuthorData, req.result.author);
                }
            }
            renderFeeds();
            renderNewsFeed();
            renderBookFeed();
            renderProfile();
        };
    }

