        if(box) {
            box.style.display = (box.style.display === 'flex') ? 'none' : 'flex';
        }
    }

    function submitBookNestedReply(bookIdx, path) {
        let input = document.getElementById(`bookReplyInput_${path}`);
        let text = input.value.trim();
        if(!text) return;

        let indices = path.split('_').map(Number);
        let target = globalBooks[bookIdx].comments[indices[0]];
        for(let i = 1; i < indices.length; i++) {
            target = target.replies[indices[i]];
        }

        if(!target.replies) target.replies = [];
