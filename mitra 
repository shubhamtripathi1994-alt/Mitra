    function editBookComment(bookIdx, path) {
        let indices = path.split('_').map(Number);
        let target = globalBooks[bookIdx].comments[indices[0]];
        for(let i = 1; i < indices.length; i++) {
            target = target.replies[indices[i]];
        }

        let newText = prompt("Edit comment:", target.text);
        if(newText !== null && newText.trim() !== "") {
            target.text = newText.trim();
            saveAppData();
            renderBookModalComments();
            showToast("Comment updated!");
        }
    }

    function deleteBookComment(bookIdx, path) {
        if(confirm("Delete this comment/reply?")) {
            let indices = path.split('_').map(Number);
            if(indices.length === 1) {
                globalBooks[bookIdx].comments.splice(indices[0], 1);
            } else {
                let parent = globalBooks[bookIdx].comments[indices[0]];
                for(let i = 1; i < indices.length - 1; i++) {
                    parent = parent.replies[indices[i]];
                }
                parent.replies.splice(indices[indices.length - 1], 1);
            }
            saveAppData();
            renderBookModalComments();
            showToast("Deleted successfully!");
        }
    }

