<script>
// === MITRA FINAL FIX - POST NA DIKHNE KA SOLUTION - 0% CHHEDE ===
var SHEET_URL_FINAL = "https://script.google.com/macros/s/AKfycbz8h_rnnQC2ozYEF80GVVz2emh0ID7Hb-25AmjUhIvh117WA_9uIxyKJnLx8xjXhxeA/exec";
function mitraSafePushToSheet(obj){
  try{
    var payload={
      type:"addPost",
      id: obj.id || ("post_"+Date.now()+"_"+Math.floor(Math.random()*99999)),
      userId: localStorage.getItem("mitra_current_user_id") || "user_"+Date.now(),
      userName: obj.author || "You",
      userPhoto:"",
      content: obj.content||"",
      mediaUrl1: obj.mediaUrl||"",
      mediaType: obj.mediaUrl?"media":"text",
      likes:0, shares:0, comments:0
    };
    console.log("Mitra Push to Sheet:", payload.id);
    fetch(SHEET_URL_FINAL,{method:"POST", mode:"no-cors", body: JSON.stringify(payload)}).catch(function(e){ console.log("Push fail", e); });
  }catch(e){ console.log("Push error", e); }
}
function mitraSafeDeleteFromSheet(postId){
  try{ if(!postId) return; fetch(SHEET_URL_FINAL,{method:"POST", mode:"no-cors", body: JSON.stringify({type:"deletePost", id: postId})}).catch(function(){}); }catch(e){}
}
var _mitraLoading=false;
function mitraLoadFromSheet(){
  if(_mitraLoading) return; _mitraLoading=true;
  console.log("Mitra Loading from Sheet...");
  try{
    fetch(SHEET_URL_FINAL+"?action=getPosts")
    .then(function(r){ return r.text(); })
    .then(function(txt){
      console.log("Sheet Response:", txt.substring(0,200));
      try{
        var data=JSON.parse(txt);
        if(data && data.posts && data.posts.length>0){
          var exist={}; 
          try{ for(var i=0;i<globalPosts.length;i++) if(globalPosts[i]&&globalPosts[i].id) exist[globalPosts[i].id]=true; }catch(e){}
          var added=0;
          for(var j=0;j<data.posts.length;j++){
            var sp=data.posts[j];
            if(!sp || !sp.content) continue;
            if(sp.deleted===true || sp.deleted==="true") continue;
            if(!sp.id) continue;
            if(exist[sp.id]) continue;
            // Don't add own posts again if already exist by content match recent 5 sec
            globalPosts.unshift({
              id: sp.id,
              author: sp.userName || sp.userId || "Mitra",
              dateTime: sp.timestamp || new Date().toLocaleString(),
              content: sp.content,
              mediaUrl: sp.mediaUrl1 || "",
              textColor:"", privacy:"Public",
              superb: parseInt(sp.likes||0),
              excellent:0,
              share: parseInt(sp.shares||0),
              comments:[],
              userLikedSuperb:false,
              userLikedExcellent:false,
              fromSheet:true
            });
            exist[sp.id]=true;
            added++;
          }
          console.log("Mitra Added from Sheet:", added);
          if(added>0){
            try{ 
              if(typeof renderFeeds==="function") renderFeeds(); 
              if(typeof renderProfile==="function") renderProfile();
              if(typeof saveAppData==="function") saveAppData();
            }catch(e){ console.log(e); }
          }
        } else {
          console.log("Sheet empty or no posts field");
        }
      }catch(e){ console.log("Parse error", e, txt); }
      _mitraLoading=false;
    })
    .catch(function(err){ console.log("Fetch error", err); _mitraLoading=false; });
  }catch(e){ _mitraLoading=false; console.log("Load error", e); }
}
// Auto load after 1 sec and every 15 sec
setTimeout(function(){ mitraLoadFromSheet(); }, 2000);
setInterval(function(){ mitraLoadFromSheet(); }, 15000);
</script>

