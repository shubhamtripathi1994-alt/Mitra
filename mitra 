    function toggleBookReaction(index, type) {
        let item = globalBooks[index];
        if(type === 'superb') {
            if(!item.userLikedSuperb) {
                item.superb = (item.superb || 0) + 1;
                item.userLikedSuperb = true;
            } else {
                item.superb = Math.max(0, (item.superb || 1) - 1);
                item.userLikedSuperb = false;
            }
        } else if(type === 'excellent') {
            if(!item.userLikedExcellent) {
                item.excellent = (item.excellent || 0) + 1;
                item.userLikedExcellent = true;
            } else {
                item.excellent = Math.max(0, (item.excellent || 1) - 1);
                item.userLikedExcellent = false;
            }
        }
        saveAppData();
        renderBookFeed();
        if(document.getElementById('authorProfileScreen').style.display === 'block') {
            renderAuthorProfile(activeViewingAuthorName);
        }
    }

