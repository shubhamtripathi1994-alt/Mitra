    function likeBookComment(bookIdx, path, type) {
        let indices = path.split('_').map(Number);
        let target = globalBooks[bookIdx].comments[indices[0]];
        for(let i = 1; i < indices.length; i++) {
            target = target.replies[indices[i]];
        }

        if(type === 'superb') {
            if(!target.userLikedSuperb) {
                target.superb = (target.superb || 0) + 1;
                target.userLikedSuperb = true;
            } else {
                target.superb = Math.max(0, (target.superb || 1) - 1);
                target.userLikedSuperb = false;
            }
        } else if(type === 'excellent') {
            if(!target.userLikedExcellent) {
                target.excellent = (target.excellent || 0) + 1;
                target.userLikedExcellent = true;
            } else {
                target.excellent = Math.max(0, (target.excellent || 1) - 1);
                target.userLikedExcellent = false;
            }
        }
        saveAppData();
        renderBookModalComments();
    }

