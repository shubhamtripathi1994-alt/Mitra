        if(!feedArea) return;
        let html = "";

        channelNewsList.forEach((news, nIdx) => {
            let mediaHtml = "";
            let ytMatch = news.body.match(/(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?)\/|\S*?[?&]v=)|youtu\.be\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/);
            if(ytMatch) {
                let videoId = ytMatch[1];
                let ytEmbedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}`;
                mediaHtml += `
                <div style="position:relative; width:100%; height:315px; margin-top:10px;">
                    <iframe width="100%" height="315" src="${ytEmbedUrl}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border-radius:8px;"></iframe>
                </div>`;
            }

            if(news.mediaUrl) {
                if(news.mediaUrl.match(/\.(mp4|webm|ogg)$/i) || news.mediaUrl.startsWith('data:video')) {
                    mediaHtml += `<video src="${news.mediaUrl}" controls muted loop playsinline style="width:100%; border-radius:8px; margin-top:10px;"></video>`;
                } else {
                    mediaHtml += `<img src="${news.mediaUrl}" style="width:100%; border-radius:8px; margin-top:10px;">`;
