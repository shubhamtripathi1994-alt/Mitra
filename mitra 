            }

            let superbActive = news.userLikedSuperb ? 'active-highlight' : '';
            let excellentActive = news.userLikedExcellent ? 'active-highlight' : '';
            let commentCount = news.comments ? news.comments.length : 0;

            html += `
            <div class="card">
                <div style="display: flex; justify-content: space-between; margin-bottom: 5px; align-items: flex-start;">
                    <div style="font-size: 11px; color: #65676b;">🎤 Reporter: <b>${news.reporterName || userChannelData.reporter}</b> • ${news.dateTime}</div>
                    <span style="cursor:pointer; color:#d81b60; font-size:12px; font-weight:bold;" onclick="deleteNews(${nIdx})"><i class="fas fa-trash"></i> Delete</span>
                </div>
                <h2 style="font-size: 18px; margin: 5px 0; color: ${news.headlineColor || '#050505'};">${news.headline}</h2>
                ${locationBadge}
                <hr style="border:0; border-top:1px solid #eee; margin:10px 0;">
                <div style="font-size: 14px; line-height: 1.5; color: ${news.bodyColor || '#333333'}; white-space: pre-wrap;">${formatHashtags(news.body)}</div>
                ${mediaHtml}
                <div class="action-row">
                    <div class="action-btn ${superbActive}" onclick="toggleNewsReaction(${nIdx}, 'superb')"><i class="fas fa-star" style="color:#f1c40f;"></i> Superb (${news.superb || 0})</div>
                    <div class="action-btn ${excellentActive}" onclick="toggleNewsReaction(${nIdx}, 'excellent')"><i class="fas fa-fire" style="color:#e74c3c;"></i> Excellent (${news.excellent || 0})</div>
                    <div class="action-btn" onclick="openNewsCommentsModal(${nIdx})"><i class="fas fa-comment" style="color:#1877f2;"></i> Good things (${commentCount})</div>
                    <div class="action-btn" onclick="shareNews(${nIdx})"><i class="fas fa-share" style="color:#27ae60;"></i> Pass on (${news.share || 0})</div>
                </div>
            </div>`;
        });

        feedArea.innerHTML = html || `<div class="card" style="text-align:center; color:#65676b; padding:20px;">No bulletins published by this channel yet. Post your first news report!</div>`;
    }

